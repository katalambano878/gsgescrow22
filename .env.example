# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sell-Safe Buy-Safe

# First-party auth (min 32 chars) — required for login sessions
AUTH_SECRET=

# Postgres (plain — fleet-postgres in production)
DATABASE_URL=postgresql://sbbs:password@localhost:5432/sbbs

# Disk storage (Coolify volume in production)
STORAGE_ROOT=./.data/storage
STORAGE_SIGNING_SECRET=

# Moolre (MoMo + SMS)
MOOLRE_USERNAME=
MOOLRE_PUBLIC_KEY=
MOOLRE_API_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_BUSINESS_EMAIL=
MOOLRE_WEBHOOK_SECRET=
MOOLRE_SMS_VASKEY=
MOOLRE_SMS_SENDER_ID=SBBS
MOOLRE_SMS_SCENARIO=

# Paystack (cards — kill-switched by default)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
CARD_PAYMENTS_ENABLED=false

# Email
RESEND_API_KEY=
RESEND_FROM=SBBS <hello@sbbs.gh>

# Cron
CRON_SECRET=

# Full-site maintenance gate (proxy redirects everyone to /maintenance)
MAINTENANCE_MODE=false
# Optional: visit /?maint_key=SECRET to bypass while mode is on
MAINTENANCE_BYPASS_SECRET=
RECON_REPORT_TO=
OPS_ALERT_PHONES=

# Platform fee defaults (override via admin settings)
PLATFORM_BUYER_FEE_BPS=150
PLATFORM_SELLER_FEE_BPS=150
PLATFORM_TXN_CAP_PESEWAS=200000
PLATFORM_AUTO_RELEASE_HOURS=72
